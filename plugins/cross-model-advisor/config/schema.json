{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dumplingsensei/codex-pr-reviewer/plugins/cross-model-advisor/config/schema.json",
  "title": "cross-model-advisor user configuration",
  "description": "Trusted user config at ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/cross-model-advisor.json. Schema versions 1 and 2. Version 1 is strict. Version 2 adds advisor enabled/reasoningEffort, empty collections with reference integrity, and optional paired compatible thinking metadata with optional supportsReasoningEffort. Choose real model ids; this schema is not a runnable default and does not use Claude credentials.",
  "oneOf": [
    { "$ref": "#/$defs/v1Document" },
    { "$ref": "#/$defs/v2Document" }
  ],
  "$defs": {
    "apiKeyEnv": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Environment variable NAME only. Never persist the key value."
    },
    "apiProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "apiKeyEnv"],
      "properties": {
        "kind": { "const": "api" },
        "provider": {
          "type": "string",
          "enum": ["openai", "anthropic", "google", "openrouter", "zai", "xai", "moonshotai", "kimi-coding"]
        },
        "apiKeyEnv": { "$ref": "#/$defs/apiKeyEnv" }
      }
    },
    "oauthProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider"],
      "properties": {
        "kind": { "const": "oauth" },
        "provider": {
          "type": "string",
          "enum": ["openai-codex", "github-copilot", "xai", "kimi-coding"],
          "description": "Upstream SDK id. Distinct from the configured slot name. No Anthropic, Antigravity, or OpenRouter OAuth."
        }
      }
    },
    "modelInput": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["text", "image"] }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "number", "minimum": 0 },
        "completion": { "type": "number", "minimum": 0 }
      }
    },
    "nativeLevel": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\u0000-\u001f\u007f]+$"
        }
      ]
    },
    "thinkingLevelMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
      "properties": {
        "off": { "$ref": "#/$defs/nativeLevel" },
        "minimal": { "$ref": "#/$defs/nativeLevel" },
        "low": { "$ref": "#/$defs/nativeLevel" },
        "medium": { "$ref": "#/$defs/nativeLevel" },
        "high": { "$ref": "#/$defs/nativeLevel" },
        "xhigh": { "$ref": "#/$defs/nativeLevel" },
        "max": { "$ref": "#/$defs/nativeLevel" }
      }
    },
    "v1CompatModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contextWindow", "maxTokens", "reasoning", "input"],
      "properties": {
        "contextWindow": { "type": "integer", "minimum": 1 },
        "maxTokens": { "type": "integer", "minimum": 1 },
        "reasoning": { "type": "boolean" },
        "input": { "$ref": "#/$defs/modelInput" },
        "pricing": { "$ref": "#/$defs/pricing" }
      }
    },
    "v2CompatModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contextWindow", "maxTokens", "reasoning", "input"],
      "dependentRequired": {
        "thinkingFormat": ["thinkingLevelMap"],
        "thinkingLevelMap": ["thinkingFormat"],
        "supportsReasoningEffort": ["thinkingFormat", "thinkingLevelMap"]
      },
      "properties": {
        "contextWindow": { "type": "integer", "minimum": 1 },
        "maxTokens": { "type": "integer", "minimum": 1 },
        "reasoning": { "type": "boolean" },
        "input": { "$ref": "#/$defs/modelInput" },
        "pricing": { "$ref": "#/$defs/pricing" },
        "thinkingFormat": {
          "type": "string",
          "enum": ["openai", "openrouter", "zai"],
          "description": "Must be paired with thinkingLevelMap. reasoning true alone is not tunable."
        },
        "thinkingLevelMap": { "$ref": "#/$defs/thinkingLevelMap" },
        "supportsReasoningEffort": {
          "type": "boolean",
          "description": "Valid only with thinkingFormat and thinkingLevelMap. true: native reasoning_effort; false: enable-only and must not emit reasoning_effort. Omitted is not filled; resolver defaults openai/openrouter to true and zai to false."
        }
      }
    },
    "v1CompatProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "apiKeyEnv", "baseUrl", "models"],
      "properties": {
        "kind": { "const": "api" },
        "provider": { "const": "openai-compatible" },
        "apiKeyEnv": { "$ref": "#/$defs/apiKeyEnv" },
        "baseUrl": {
          "type": "string",
          "minLength": 1,
          "description": "HTTPS required except explicit localhost/loopback HTTP. OpenAI Chat Completions wire protocol."
        },
        "models": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/v1CompatModel" }
        }
      }
    },
    "v2CompatProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "apiKeyEnv", "baseUrl", "models"],
      "properties": {
        "kind": { "const": "api" },
        "provider": { "const": "openai-compatible" },
        "apiKeyEnv": { "$ref": "#/$defs/apiKeyEnv" },
        "baseUrl": {
          "type": "string",
          "minLength": 1,
          "description": "HTTPS required except explicit localhost/loopback HTTP. OpenAI Chat Completions wire protocol."
        },
        "models": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/v2CompatModel" }
        }
      }
    },
    "exclude": {
      "type": "array",
      "default": [],
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "description": "gitignore-style patterns that may only narrow access. Negation with ! is rejected."
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxConcurrentAdvisors": { "type": "integer", "minimum": 1, "maximum": 16, "default": 2 },
        "reviewTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 240, "default": 90, "description": "Per-advisor review deadline. The Stop hook itself times out at 300 seconds." },
        "maxToolCallsPerReview": { "type": "integer", "minimum": 1, "maximum": 100, "default": 8 },
        "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 100000, "default": 1500 },
        "maxReviewsPerAdvisorPerSession": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 40 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "description": "Review after Claude finishes a turn that changed files.",
      "properties": {
        "mode": {
          "enum": ["block", "report"],
          "default": "block",
          "description": "block: concerns and blockers send Claude back to address them. report: findings are only shown to the user."
        },
        "maxRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 2,
          "description": "How many times one prompt can be sent back before Claude is allowed to stop."
        },
        "autoOn": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "description": "Absolute git project roots where the gate turns on at session start, without /cross-model-advisor:on. /cross-model-advisor:off still wins for that session. Only this user file can list a project."
        },
        "skipWhenOnly": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024, "not": { "pattern": "^\\s*!" } },
          "description": "gitignore-style patterns. A turn whose changed files all match is not reviewed; matching files stay visible to advisors in other turns."
        }
      }
    },
    "v1Advisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "provider", "model", "instructions"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "description": "Unique restricted identifier."
        },
        "provider": {
          "type": "string",
          "description": "Key of an entry in providers."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "User-selected model id. For openai-compatible providers this must be a key in that provider's models map."
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "Literal review focus from the trusted user config. Not a command."
        }
      }
    },
    "v2Advisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "provider", "model", "instructions", "enabled", "reasoningEffort"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "description": "Unique restricted identifier."
        },
        "provider": {
          "type": "string",
          "description": "Key of an entry in providers."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "User-selected model id. For openai-compatible providers this must be a key in that provider's models map."
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "Literal review focus from the trusted user config. Not a command."
        },
        "enabled": {
          "type": "boolean",
          "description": "Configured enabled state. Version-1 input normalizes to true."
        },
        "reasoningEffort": {
          "type": "string",
          "enum": ["default", "off", "minimal", "low", "medium", "high", "xhigh", "max"],
          "description": "Advisor-level effort. default preserves prior request behavior. Version-1 input normalizes to default."
        }
      }
    },
    "v1Document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "providers", "advisors"],
      "properties": {
        "version": {
          "const": 1,
          "description": "JSON schema version 1. New fields are valid only in version 2."
        },
        "providers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,63}$": {
              "oneOf": [
                { "$ref": "#/$defs/apiProvider" },
                { "$ref": "#/$defs/v1CompatProvider" },
                { "$ref": "#/$defs/oauthProvider" }
              ]
            }
          }
        },
        "advisors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/v1Advisor" }
        },
        "exclude": { "$ref": "#/$defs/exclude" },
        "limits": { "$ref": "#/$defs/limits" },
        "gate": { "$ref": "#/$defs/gate" }
      }
    },
    "v2Document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "providers", "advisors"],
      "properties": {
        "version": {
          "const": 2,
          "description": "JSON schema version 2. Empty providers/advisors are valid when references remain intact."
        },
        "providers": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,63}$": {
              "oneOf": [
                { "$ref": "#/$defs/apiProvider" },
                { "$ref": "#/$defs/v2CompatProvider" },
                { "$ref": "#/$defs/oauthProvider" }
              ]
            }
          }
        },
        "advisors": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/v2Advisor" }
        },
        "exclude": { "$ref": "#/$defs/exclude" },
        "limits": { "$ref": "#/$defs/limits" },
        "gate": { "$ref": "#/$defs/gate" }
      }
    }
  }
}
